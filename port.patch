+bool Dx12NR::init_ngx_session()
+{
+  feature_paths_[0] = runtime_dir_.c_str();
+  NVSDK_NGX_FeatureCommonInfo common;
+  common.PathListInfo = {feature_paths_, 1};
+  common.internal_data = nullptr;
+  common.LoggingInfo = {nullptr, 1, false};
+
+  const std::string data_dir = std::filesystem::path(cache_dir_).u8string();
+  const char *project_id = "e40890d0-da76-467b-8130-12f3ada8d7c8";
+  const char *custom_project_id = "53f803cc-a12f-4d69-90d5-19b7599cad19";
+  NgxResult result = NgxResult(0);
+
+  if (core_init_project_id_ != nullptr) {
+    result = call_core_init_project(core_init_project_id_,
+                                    project_id,
+                                    kEngineTypeUnity,
+                                    "6000.3",
+                                    runtime_dir_.c_str(),
+                                    device_.Get(),
+                                    &common,
+                                    kSdkSnippet);
+  }
+  if (result != kNgxSuccess && core_init_project_ != nullptr) {
+    result = call_core_init_project(core_init_project_,
+                                    project_id,
+                                    kEngineTypeUnity,
+                                    "6000.3",
+                                    runtime_dir_.c_str(),
+                                    device_.Get(),
+                                    &common,
+                                    kSdkSnippet);
+  }
+  if (result != kNgxSuccess && core_init_project_id_ != nullptr) {
+    result = call_core_init_project(core_init_project_id_,
+                                    custom_project_id,
+                                    6,
+                                    "0.3.0",
+                                    runtime_dir_.c_str(),
+                                    device_.Get(),
+                                    &common,
+                                    kSdkSnippet);
+  }
+  for (int version = 0x13; result != kNgxSuccess && version <= 0x20; ++version) {
+    result = call_core_init_ext(core_init_ext_,
+                                kAppIdUnity,
+                                runtime_dir_.c_str(),
+                                device_.Get(),
+                                version,
+                                &common);
+  }
+  if (result != kNgxSuccess) {
+    set_nr_error("NVNGX core (_nvngx.dll) init failed.");
+    return false;
+  }
+
+  result = NgxResult(0);
+  if (snippet_init_ext_ != nullptr) {
+    result = call_snippet_init(snippet_init_ext_,
+                               kAppIdUnity,
+                               runtime_dir_.c_str(),
+                               device_.Get(),
+                               &common,
+                               kSdkSnippet);
+    if (result != kNgxSuccess) {
+      result = call_snippet_init(snippet_init_ext_,
+                                 kAppIdPhoenix,
+                                 runtime_dir_.c_str(),
+                                 device_.Get(),
+                                 &common,
+                                 kSdkSnippet);
+    }
+  }
+  if (result != kNgxSuccess && snippet_init_ext_core_abi_ != nullptr) {
+    result = call_snippet_init_core_abi(snippet_init_ext_core_abi_,
+                                        kAppIdUnity,
+                                        runtime_dir_.c_str(),
+                                        device_.Get(),
+                                        kSdkSnippet,
+                                        &common);
+    if (result != kNgxSuccess) {
+      result = call_snippet_init_core_abi(snippet_init_ext_core_abi_,
+                                          kAppIdPhoenix,
+                                          runtime_dir_.c_str(),
+                                          device_.Get(),
+                                          kSdkSnippet,
+                                          &common);
+    }
+  }
+  if (result != kNgxSuccess) {
+    set_nr_error("nvngx_dlssnr.dll init failed. A signed nvngx_dlssnr.dll is required.");
+    return false;
+  }
+  ngx_ready_ = true;
+  return true;
+}

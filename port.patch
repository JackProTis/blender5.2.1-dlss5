+static std::wstring find_driver_store_core()
+{
+  wchar_t system32[MAX_PATH] = {};
+  if (GetSystemDirectoryW(system32, ARRAYSIZE(system32)) == 0) {
+    return {};
+  }
+  const std::wstring root = (std::filesystem::path(system32) / L"DriverStore" / L"FileRepository").wstring();
+  std::error_code error;
+  if (!std::filesystem::is_directory(root, error)) {
+    return {};
+  }
+  std::wstring newest_name;
+  std::wstring newest_path;
+  std::filesystem::file_time_type newest_time = std::filesystem::file_time_type::min();
+  for (const auto &entry :
+       std::filesystem::directory_iterator(root,
+                                           std::filesystem::directory_options::skip_permission_denied,
+                                           error))
+  {
+    if (!entry.is_directory()) {
+      continue;
+    }
+    const std::wstring name = entry.path().filename().wstring();
+    if (name.size() < 4 || name.compare(0, 2, L"nv") != 0 ||
+        name.find(L".inf_") == std::wstring::npos)
+    {
+      continue;
+    }
+    const std::wstring candidate = (entry.path() / L"_nvngx.dll").wstring();
+    std::error_code file_error;
+    if (!std::filesystem::is_regular_file(candidate, file_error)) {
+      continue;
+    }
+    const bool is_dispi = name.find(L"nv_dispi") != std::wstring::npos;
+    const bool current_dispi = newest_name.find(L"nv_dispi") != std::wstring::npos;
+    const auto time = std::filesystem::last_write_time(candidate, file_error);
+    bool better = false;
+    if (newest_path.empty()) {
+      better = true;
+    }
+    else if (is_dispi != current_dispi) {
+      better = is_dispi;
+    }
+    else if (!file_error) {
+      better = time > newest_time;
+    }
+    if (better) {
+      newest_name = name;
+      newest_path = candidate;
+      if (!file_error) {
+        newest_time = time;
+      }
+    }
+  }
+  return newest_path;
+}
+
+static std::wstring ngx_data_directory()
+{
+  const wchar_t *env = _wgetenv(L"DLSS5_CACHE_DIR");
+  if (env != nullptr && *env != 0) {
+    std::wstring dir = env;
+    std::error_code error;
+    if (std::filesystem::is_directory(dir, error) ||
+        std::filesystem::create_directories(dir, error))
+    {
+      return dir;
+    }
+  }
+  char cache[512] = {};
+  BKE_appdir_folder_caches(cache, sizeof(cache));
+  if (cache[0] == 0) {
+    return {};
+  }
+  const std::wstring dir = (std::filesystem::path(utf8_to_wstring(cache)) / L"dlss5").wstring();
+  std::error_code error;
+  std::filesystem::create_directories(dir, error);
+  return dir;
+}

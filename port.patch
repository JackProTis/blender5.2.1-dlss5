+bool Dx12NR::load_modules()
+{
+  runtime_dir_ = find_nr_runtime_dir();
+  cache_dir_ = ngx_data_directory();
+  if (runtime_dir_.empty()) {
+    set_nr_error("nvngx_dlssnr.dll not found. Place your DLSS5 (dlss5) folder next to Blender, or set DLSS5_RUNTIME_DIR.");
+    return false;
+  }
+  if (cache_dir_.empty()) {
+    set_nr_error("DLSS5 cache directory could not be created. Set DLSS5_CACHE_DIR.");
+    return false;
+  }
+
+  std::vector<std::wstring> core_candidates;
+  const std::wstring driver_store = find_driver_store_core();
+  if (!driver_store.empty()) {
+    core_candidates.push_back(driver_store);
+  }
+  const std::wstring runtime_core[] = {
+      (std::filesystem::path(runtime_dir_) / L"_nvngx.dll").wstring(),
+      (std::filesystem::path(runtime_dir_) / L"nvngx.dll").wstring(),
+  };
+  for (const std::wstring &path : runtime_core) {
+    core_candidates.push_back(path);
+  }
+  core_candidates.push_back((std::filesystem::path(L"C:\\Windows\\System32") / L"_nvngx.dll").wstring());
+
+  std::error_code error;
+  for (const std::wstring &path : core_candidates) {
+    if (!std::filesystem::is_regular_file(path, error)) {
+      continue;
+    }
+    HMODULE module = LoadLibraryExW(path.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+    if (module != nullptr) {
+      core_ = module;
+      break;
+    }
+  }
+  if (core_ == nullptr) {
+    set_nr_error("_nvngx.dll (NVNGX core) not found. Install the NVIDIA app or DLSS, or copy _nvngx.dll/nvngx.dll into the dlss5 directory.");
+    return false;
+  }
+
+  const std::wstring snippet_path = (std::filesystem::path(runtime_dir_) / L"nvngx_dlssnr.dll").wstring();
+  snippet_ = LoadLibraryExW(snippet_path.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+  if (snippet_ == nullptr) {
+    set_nr_error("nvngx_dlssnr.dll could not be loaded from the dlss5 directory.");
+    return false;
+  }
+
+  core_init_project_id_ = reinterpret_cast<NgxInitProjectFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_Init_with_ProjectID"));
+  core_init_project_ = reinterpret_cast<NgxInitProjectFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_Init_ProjectID"));
+  core_init_ext_ = reinterpret_cast<NgxInitExtCoreFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_Init_Ext"));
+  core_shutdown1_ = reinterpret_cast<NgxShutdownFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_Shutdown1"));
+  core_alloc_params_ = reinterpret_cast<NgxAllocFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_AllocateParameters"));
+  core_destroy_params_ = reinterpret_cast<NgxDestroyPFn>(
+      GetProcAddress(core_, "NVSDK_NGX_D3D12_DestroyParameters"));
+
+  snippet_init_ext_ = reinterpret_cast<NgxInitExtSnippetFn>(
+      GetProcAddress(snippet_, "NVSDK_NGX_D3D12_Init_Ext"));
+  snippet_init_ext_core_abi_ = reinterpret_cast<NgxInitExtCoreFn>(
+      GetProcAddress(snippet_, "NVSDK_NGX_D3D12_Init_Ext"));
+  snippet_create_ = reinterpret_cast<NgxCreateFn>(
+      GetProcAddress(snippet_, "NVSDK_NGX_D3D12_CreateFeature"));
+  snippet_eval_ = reinterpret_cast<NgxEvalFn>(
+      GetProcAddress(snippet_, "NVSDK_NGX_D3D12_EvaluateFeature"));
+  snippet_release_ = reinterpret_cast<NgxReleaseFn>(
+      GetProcAddress(snippet_, "NVSDK_NGX_D3D12_ReleaseFeature"));
+
+  if (core_init_ext_ == nullptr || core_alloc_params_ == nullptr ||
+      core_destroy_params_ == nullptr || snippet_init_ext_ == nullptr ||
+      snippet_create_ == nullptr || snippet_eval_ == nullptr)
+  {
+    set_nr_error("nvngx_dlssnr.dll exports are missing. Unsigned or wrong-version binaries?");
+    return false;
+  }
+
+  if (!hook_snippet_get_module_file_name(snippet_, core_, &iat_slot_)) {
+    set_nr_error("Could not patch the nvngx_dlssnr.dll import table (GetModuleFileNameW).");
+    return false;
+  }
+  feature_paths_[0] = runtime_dir_.c_str();
+  return true;
+}

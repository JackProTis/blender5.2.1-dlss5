+  bool ensure_feature(int width, int height, bool have_depth, bool have_motion, const DLSSNRParams &params);
+  void set_params(int width, int height, bool have_depth, bool have_motion, const DLSSNRParams &params, bool do_reset);
+  void stage_inputs(const Result &color,
+                    const Result *depth,
+                    const Result *motion,

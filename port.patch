+class ScopedYieldBlenderGPU {
+ public:
+  /* Viewport compositor runs inside DRW_draw_view. Unbinding GHOST there destroys the window
+   * GPU context and the next node's Result* can go null (mute crash in EEVEE viewport). Only
+   * isolate on the compositor job thread. */
+  explicit ScopedYieldBlenderGPU(const bool isolate)
+  {
+    if (!isolate) {
+      return;
+    }
+    ghost_ = GHOST_IContext::getActiveDrawingContext();
+    gpu_ctx_ = GPU_context_active_get();
+    /* Flush and unbind Blender GPU first while the GHOST context is still current. */
+    if (gpu_ctx_ != nullptr) {
+      GPU_context_active_set(nullptr);
+    }
+    /* Drop the native Vulkan/GL context so D3D12/NGX does not share the thread with it. */
+    if (ghost_ != nullptr) {
+      ghost_->releaseDrawingContext();
+    }
+  }
+
+  ~ScopedYieldBlenderGPU()
+  {
+    if (ghost_ != nullptr) {
+      ghost_->activateDrawingContext();
+    }
+    if (gpu_ctx_ != nullptr) {
+      GPU_context_active_set(gpu_ctx_);
+    }
+  }
+
+  ScopedYieldBlenderGPU(const ScopedYieldBlenderGPU &) = delete;
+  ScopedYieldBlenderGPU &operator=(const ScopedYieldBlenderGPU &) = delete;
+
+ private:
+  GPUContext *gpu_ctx_ = nullptr;
+  GHOST_IContext *ghost_ = nullptr;
+};
+
+bool apply_dlssnr(Context &context,
+                  const Result &color,
+                  const Result *depth,
+                  const Result *motion,
+                  const Result *mask,
+                  const Result * /*albedo*/,
+                  const Result * /*normal*/,
+                  const DLSSNRParams &params,
+                  Result &output)
+{
+  if (context.is_canceled()) {
+    return false;
+  }
+  if (!color.is_allocated() || color.is_single_value()) {
+    return false;
+  }
+  if (color.domain().data_size.x < 32 || color.domain().data_size.y < 32) {
+    return false;
+  }
+
+  output.allocate_texture(color.domain(), true, ResultStorageType::CPU);
+  {
+    /* Compositor job thread: isolate D3D12 from Vulkan. Viewport draw: keep GHOST bound. */
+    ScopedYieldBlenderGPU yield_gpu(!context.is_viewport());
+    if (!CompositorDLSSNR::instance().apply(color, depth, motion, mask, params, output)) {
+      return false;
+    }
+  }
+  return !context.is_canceled();
+}

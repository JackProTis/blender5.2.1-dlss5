+bool Dx12NR::ensure_feature(int width,
+                            int height,
+                            bool have_depth,
+                            bool have_motion,
+                            const DLSSNRParams &params)
+{
+  const int style = std::clamp(int(params.style), 0, 2);
+  if (handle_ != nullptr && width == last_width_ && height == last_height_ &&
+      style == last_style_ && have_depth == last_have_depth_ &&
+      have_motion == last_have_motion_)
+  {
+    return true;
+  }
+  if (handle_ != nullptr && snippet_release_ != nullptr) {
+    snippet_release_(handle_);
+  }
+  handle_ = nullptr;
+
+  last_width_ = width;
+  last_height_ = height;
+  last_style_ = style;
+  last_have_depth_ = have_depth;
+  last_have_motion_ = have_motion;
+  has_history_ = false;
+
+  D3D12_RESOURCE_DESC base_desc = {};
+  base_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  base_desc.Width = width;
+  base_desc.Height = height;
+  base_desc.DepthOrArraySize = 1;
+  base_desc.MipLevels = 1;
+  base_desc.SampleDesc.Count = 1;
+
+  D3D12_HEAP_PROPERTIES default_heap = {};
+  default_heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+  D3D12_RESOURCE_DESC color_desc = base_desc;
+  color_desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  color_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  if (FAILED(device_->CreateCommittedResource(&default_heap,
+                                              D3D12_HEAP_FLAG_NONE,
+                                              &color_desc,
+                                              D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                              nullptr,
+                                              IID_PPV_ARGS(&tex_color_))))
+  {
+    set_nr_error("CreateCommittedResource (color) failed.");
+    return false;
+  }
+  if (FAILED(device_->CreateCommittedResource(&default_heap,
+                                              D3D12_HEAP_FLAG_NONE,
+                                              &color_desc,
+                                              D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                              nullptr,
+                                              IID_PPV_ARGS(&tex_output_))))
+  {
+    set_nr_error("CreateCommittedResource (output) failed.");
+    return false;
+  }
+
+  tex_depth_.Reset();
+  tex_motion_.Reset();
+  D3D12_RESOURCE_DESC guide_desc = base_desc;
+  guide_desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+  if (have_depth) {
+    guide_desc.Format = DXGI_FORMAT_R32_FLOAT;
+    if (FAILED(device_->CreateCommittedResource(&default_heap,
+                                                D3D12_HEAP_FLAG_NONE,
+                                                &guide_desc,
+                                                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                                                nullptr,
+                                                IID_PPV_ARGS(&tex_depth_))))
+    {
+      set_nr_error("CreateCommittedResource (depth) failed.");
+      return false;
+    }
+  }
+  if (have_motion) {
+    guide_desc.Format = DXGI_FORMAT_R16G16_FLOAT;
+    if (FAILED(device_->CreateCommittedResource(&default_heap,
+                                                D3D12_HEAP_FLAG_NONE,
+                                                &guide_desc,
+                                                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                                                nullptr,
+                                                IID_PPV_ARGS(&tex_motion_))))
+    {
+      set_nr_error("CreateCommittedResource (motion) failed.");
+      return false;
+    }
+  }
+
+  UINT64 upload_bytes = 0;
+  auto reserve_upload = [this, &upload_bytes](const D3D12_RESOURCE_DESC &texture_desc,
+                                              D3D12_PLACED_SUBRESOURCE_FOOTPRINT &footprint,
+                                              UINT64 &bytes) {
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout = {};
+    device_->GetCopyableFootprints(&texture_desc, 0, 1, 0, &layout, nullptr, nullptr, nullptr);
+    layout.Footprint.RowPitch = (layout.Footprint.RowPitch + 511) & ~511ull;
+    const UINT64 needed = size_t(layout.Footprint.Height) * layout.Footprint.RowPitch;
+    upload_bytes = (upload_bytes + 511) & ~511ull;
+    layout.Offset = upload_bytes;
+    upload_bytes += needed;
+    footprint = layout;
+    bytes = needed;
+    return needed;
+  };
+
+  color_bytes_ = 0;
+  depth_bytes_ = 0;
+  motion_bytes_ = 0;
+  reserve_upload(color_desc, fp_color_, color_bytes_);
+  if (have_depth) {
+    guide_desc.Format = DXGI_FORMAT_R32_FLOAT;
+    reserve_upload(guide_desc, fp_depth_, depth_bytes_);
+  }
+  if (have_motion) {
+    guide_desc.Format = DXGI_FORMAT_R16G16_FLOAT;
+    reserve_upload(guide_desc, fp_motion_, motion_bytes_);
+  }
+  upload_bytes = (upload_bytes + 511) & ~511ull;
+
+  upload_.Reset();
+  if (upload_bytes > 0) {
+    D3D12_RESOURCE_DESC buffer_desc = {};
+    buffer_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer_desc.Width = upload_bytes;
+    buffer_desc.Height = 1;
+    buffer_desc.DepthOrArraySize = 1;
+    buffer_desc.MipLevels = 1;
+    buffer_desc.SampleDesc.Count = 1;
+    buffer_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_HEAP_PROPERTIES upload_heap = {};
+    upload_heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    if (FAILED(device_->CreateCommittedResource(&upload_heap,
+                                                D3D12_HEAP_FLAG_NONE,
+                                                &buffer_desc,
+                                                D3D12_RESOURCE_STATE_GENERIC_READ,
+                                                nullptr,
+                                                IID_PPV_ARGS(&upload_))))
+    {
+      set_nr_error("CreateCommittedResource (upload) failed.");
+      return false;
+    }
+  }
+
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT output_layout = {};
+  device_->GetCopyableFootprints(&color_desc, 0, 1, 0, &output_layout, nullptr, nullptr, nullptr);
+  output_layout.Footprint.RowPitch = (output_layout.Footprint.RowPitch + 511) & ~511ull;
+  output_bytes_ = size_t(output_layout.Footprint.Height) * output_layout.Footprint.RowPitch;
+  fp_output_ = output_layout;
+  readback_.Reset();
+  D3D12_RESOURCE_DESC readback_desc = {};
+  readback_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  readback_desc.Width = output_bytes_;
+  readback_desc.Height = 1;
+  readback_desc.DepthOrArraySize = 1;
+  readback_desc.MipLevels = 1;
+  readback_desc.SampleDesc.Count = 1;
+  readback_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  D3D12_HEAP_PROPERTIES readback_heap = {};
+  readback_heap.Type = D3D12_HEAP_TYPE_READBACK;
+  if (FAILED(device_->CreateCommittedResource(&readback_heap,
+                                              D3D12_HEAP_FLAG_NONE,
+                                              &readback_desc,
+                                              D3D12_RESOURCE_STATE_COPY_DEST,
+                                              nullptr,
+                                              IID_PPV_ARGS(&readback_))))
+  {
+    set_nr_error("CreateCommittedResource (readback) failed.");
+    return false;
+  }
+
+  set_params(width, height, have_depth, have_motion, params, true);
+  const NgxResult result = call_create(snippet_create_, cmdlist_.Get(), kFeatureId, params_, &handle_);
+  if (result != kNgxSuccess) {
+    char buffer[128];
+    SNPRINTF(buffer,
+             "CreateFeature(18) failed (0x%08x). Need signed nvngx_dlssnr.dll and RTX 50.",
+             unsigned(result));
+    set_nr_error(buffer);
+    handle_ = nullptr;
+    return false;
+  }
+  execute_and_wait();
+  return true;
+}
+
+void Dx12NR::set_params(int width,
+                        int height,
+                        bool have_depth,
+                        bool have_motion,
+                        const DLSSNRParams &params,
+                        bool do_reset)
+{
+  SetResource(params_, "DLSSNR.Color", tex_color_.Get());
+  SetResource(params_, "DLSSNR.Output", tex_output_.Get());
+  SetResource(params_, "DLSSNR.Backbuffer", do_reset ? tex_color_.Get() : tex_output_.Get());
+  SetResource(params_, "DLSSNR.Depth", have_depth ? tex_depth_.Get() : nullptr);
+  SetResource(params_, "DLSSNR.MVec", have_motion ? tex_motion_.Get() : nullptr);
+  SetI(params_, "Width", width);
+  SetI(params_, "Height", height);
+  SetI(params_, "OutWidth", width);
+  SetI(params_, "OutHeight", height);
+  SetUi(params_, "DLSSNR.Width", unsigned(width));
+  SetUi(params_, "DLSSNR.Height", unsigned(height));
+  SetUi(params_, "DLSSNR.Enabled", 1u);
+  SetUi(params_, "DLSSNR.Reset", do_reset ? 1u : 0u);
+  SetUi(params_, "Reset", do_reset ? 1u : 0u);
+  SetF(params_, "DLSSNR.JitterOffsetX", 0.0f);
+  SetF(params_, "DLSSNR.JitterOffsetY", 0.0f);
+  SetUi(params_, "DLSSNR.DepthInverted", 1u);
+  SetF(params_, "DLSSNR.ScalingRatio", 1.0f);
+  SetI(params_, "DLSSNR.ColorSubrectWidth", width);
+  SetI(params_, "DLSSNR.ColorSubrectHeight", height);
+  SetI(params_, "DLSSNR.ColorSubrectX", 0);
+  SetI(params_, "DLSSNR.ColorSubrectY", 0);
+  SetI(params_, "DLSSNR.OutputSubrectWidth", width);
+  SetI(params_, "DLSSNR.OutputSubrectHeight", height);
+  SetI(params_, "DLSSNR.OutputSubrectX", 0);
+  SetI(params_, "DLSSNR.OutputSubrectY", 0);
+  if (have_depth) {
+    SetI(params_, "DLSSNR.DepthSubrectWidth", width);
+    SetI(params_, "DLSSNR.DepthSubrectHeight", height);
+    SetI(params_, "DLSSNR.DepthSubrectX", 0);
+    SetI(params_, "DLSSNR.DepthSubrectY", 0);
+  }
+  if (have_motion) {
+    SetI(params_, "DLSSNR.MVecSubrectWidth", width);
+    SetI(params_, "DLSSNR.MVecSubrectHeight", height);
+    SetI(params_, "DLSSNR.MVecSubrectX", 0);
+    SetI(params_, "DLSSNR.MVecSubrectY", 0);
+  }
+  SetF(params_, "DLSSNR.MVecScaleX", 1.0f);
+  SetF(params_, "DLSSNR.MVecScaleY", 1.0f);
+  SetF(params_, "DLSSNR.Intensity", std::clamp(params.intensity, 0.0f, 2.0f));
+  SetF(params_, "DLSSNR.LocalToneStructureStrength", std::clamp(params.structure, 0.0f, 2.0f));
+  SetF(params_, "DLSSNR.LocalToneStrength", std::clamp(params.tone, 0.0f, 2.0f));
+  SetF(params_, "DLSSNR.SkinStructureStrength", std::clamp(params.skin, 0.0f, 2.0f));
+  SetI(params_, "DLSSNR.Style", std::clamp(int(params.style), 0, 2));
+  SetUi(params_, "DLSSNR.UseAutoMask", params.auto_mask ? 1u : 0u);
+  SetUi(params_, "DLSSNR.UICorrection", params.ui_correction ? 1u : 0u);
+  SetUi(params_, "CreationNodeMask", 1u);
+  SetUi(params_, "VisibilityNodeMask", 1u);
+}
+
+void Dx12NR::stage_inputs(const Result &color,
+                          const Result *depth,
+                          const Result *motion,
+                          int width,
+                          int height,
+                          bool clamp_input)
+{
+  if (upload_ == nullptr) {
+    return;
+  }
+  D3D12_RANGE range = {0, color_bytes_ + depth_bytes_ + motion_bytes_};
+  void *data = nullptr;
+  upload_->Map(0, &range, &data);
+  if (data == nullptr) {
+    return;
+  }
+  BYTE *base = static_cast<BYTE *>(data);
+
+  for (int dst_y = 0; dst_y < height; ++dst_y) {
+    const int src_y = height - 1 - dst_y;
+    for (int x = 0; x < width; ++x) {
+      const Color c = color.load_pixel<Color>(int2(x, src_y));
+      uint16_t *texel = reinterpret_cast<uint16_t *>(base + fp_color_.Offset +
+                                                     size_t(fp_color_.Footprint.RowPitch) * dst_y +
+                                                     size_t(x) * 8);
+      texel[0] = float_to_half(clamp_input ? std::clamp(c.r, 0.0f, 1.0f) : c.r);
+      texel[1] = float_to_half(clamp_input ? std::clamp(c.g, 0.0f, 1.0f) : c.g);
+      texel[2] = float_to_half(clamp_input ? std::clamp(c.b, 0.0f, 1.0f) : c.b);
+      texel[3] = float_to_half(c.a);
+    }
+    if (depth != nullptr) {
+      for (int x = 0; x < width; ++x) {
+        const float *dst_texel = reinterpret_cast<float *>(base + fp_depth_.Offset +
+                                                           size_t(fp_depth_.Footprint.RowPitch) * dst_y +
+                                                           size_t(x) * 4);
+        *const_cast<float *>(dst_texel) = depth->load_pixel<float>(int2(x, src_y));
+      }
+    }
+    if (motion != nullptr) {
+      for (int x = 0; x < width; ++x) {
+        const float2 mv = motion->load_pixel<float2>(int2(x, src_y));
+        uint16_t *texel = reinterpret_cast<uint16_t *>(base + fp_motion_.Offset +
+                                                       size_t(fp_motion_.Footprint.RowPitch) * dst_y +
+                                                       size_t(x) * 4);
+        texel[0] = float_to_half(mv.x);
+        texel[1] = float_to_half(-mv.y);
+      }
+    }
+  }
+  upload_->Unmap(0, nullptr);
+}
+
+void Dx12NR::copy_texture_from_upload()
+{
+  if (upload_ == nullptr) {
+    return;
+  }
+  auto transition = [this](ID3D12Resource *texture,
+                           D3D12_RESOURCE_STATES before,
+                           D3D12_RESOURCE_STATES after) {
+    D3D12_RESOURCE_BARRIER barrier = {};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = texture;
+    barrier.Transition.Subresource = 0;
+    barrier.Transition.StateBefore = before;
+    barrier.Transition.StateAfter = after;
+    cmdlist_->ResourceBarrier(1, &barrier);
+  };
+
+  D3D12_BOX box = {};
+  box.right = last_width_;
+  box.bottom = last_height_;
+  box.back = 1;
+
+  D3D12_TEXTURE_COPY_LOCATION dst = {};
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  dst.SubresourceIndex = 0;
+  D3D12_TEXTURE_COPY_LOCATION src = {};
+  src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  src.pResource = upload_.Get();
+
+  transition(tex_color_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_DEST);
+  dst.pResource = tex_color_.Get();
+  src.PlacedFootprint = fp_color_;
+  cmdlist_->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+  transition(tex_color_.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+
+  if (tex_depth_ != nullptr && depth_bytes_ > 0) {
+    transition(tex_depth_.Get(),
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+               D3D12_RESOURCE_STATE_COPY_DEST);
+    dst.pResource = tex_depth_.Get();
+    src.PlacedFootprint = fp_depth_;
+    cmdlist_->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+    transition(tex_depth_.Get(),
+               D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  }
+  if (tex_motion_ != nullptr && motion_bytes_ > 0) {
+    transition(tex_motion_.Get(),
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+               D3D12_RESOURCE_STATE_COPY_DEST);
+    dst.pResource = tex_motion_.Get();
+    src.PlacedFootprint = fp_motion_;
+    cmdlist_->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+    transition(tex_motion_.Get(),
+               D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  }
+}
+
+void Dx12NR::copy_texture_to_readback()
+{
+  if (readback_ == nullptr || tex_output_ == nullptr) {
+    return;
+  }
+  D3D12_RESOURCE_BARRIER barrier = {};
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barrier.Transition.pResource = tex_output_.Get();
+  barrier.Transition.Subresource = 0;
+  barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  cmdlist_->ResourceBarrier(1, &barrier);
+
+  D3D12_TEXTURE_COPY_LOCATION dst = {};
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  dst.pResource = readback_.Get();
+  dst.PlacedFootprint = fp_output_;
+  D3D12_TEXTURE_COPY_LOCATION src = {};
+  src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  src.pResource = tex_output_.Get();
+  src.SubresourceIndex = 0;
+  cmdlist_->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+
+  barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  cmdlist_->ResourceBarrier(1, &barrier);
+}
+
+void Dx12NR::download_color(Result &output,
+                            const Result &color,
+                            const Result *mask,
+                            int width,
+                            int height,
+                            bool clamp_input)
+{
+  if (readback_ == nullptr) {
+    return;
+  }
+  D3D12_RANGE range = {0, output_bytes_};
+  void *mapped = nullptr;
+  if (FAILED(readback_->Map(0, &range, &mapped))) {
+    return;
+  }
+  const BYTE *bytes = static_cast<const BYTE *>(mapped);
+
+  /* Some DLSSNR versions output BGR instead of RGB. Detect against the original input color. */
+  float diff_rgb = 0.0f;
+  float diff_bgr = 0.0f;
+  for (int64_t i = 0; i < int64_t(width) * height; i += 17) {
+    const int x = int(i % width);
+    const int y = int(i / width);
+    const uint16_t *h = reinterpret_cast<const uint16_t *>(bytes + fp_output_.Offset +
+                                                           size_t(fp_output_.Footprint.RowPitch) * y +
+                                                           size_t(x) * 8);
+    const float r = half_to_float(h[0]);
+    const float g = half_to_float(h[1]);
+    const float b = half_to_float(h[2]);
+    const Color src = color.load_pixel<Color>(int2(x, y));
+    diff_rgb += std::fabs(r - src.r) + std::fabs(g - src.g) + std::fabs(b - src.b);
+    diff_bgr += std::fabs(b - src.r) + std::fabs(g - src.g) + std::fabs(r - src.b);
+  }
+  const bool swap_rgb = diff_bgr < diff_rgb;
+
+  for (int dst_y = 0; dst_y < height; ++dst_y) {
+    /* The compositor result is stored bottom-up, the DLSSNR readback is top-down. */
+    const int src_y = height - 1 - dst_y;
+    for (int x = 0; x < width; ++x) {
+      const uint16_t *h = reinterpret_cast<const uint16_t *>(bytes + fp_output_.Offset +
+                                                             size_t(fp_output_.Footprint.RowPitch) * src_y +
+                                                             size_t(x) * 8);
+      float r = half_to_float(h[0]);
+      float g = half_to_float(h[1]);
+      float b = half_to_float(h[2]);
+      if (swap_rgb) {
+        std::swap(r, b);
+      }
+      if (clamp_input) {
+        r = std::clamp(r, 0.0f, 1.0f);
+        g = std::clamp(g, 0.0f, 1.0f);
+        b = std::clamp(b, 0.0f, 1.0f);
+      }
+      const Color src = color.load_pixel<Color>(int2(x, dst_y));
+      Color nr(r, g, b, 1.0f);
+      float amount = 1.0f;
+      if (mask != nullptr) {
+        amount = std::clamp(mask->load_pixel<Color>(int2(x, dst_y)).a, 0.0f, 1.0f);
+      }
+      nr.r = src.r + (nr.r - src.r) * amount;
+      nr.g = src.g + (nr.g - src.g) * amount;
+      nr.b = src.b + (nr.b - src.b) * amount;
+      nr.a = src.a;
+      output.store_pixel(int2(x, dst_y), nr);
+    }
+  }
+  readback_->Unmap(0, nullptr);
+}
+
+bool Dx12NR::apply(const Result &color,
+                   const Result *depth,
+                   const Result *motion,
+                   const Result *mask,
+                   const DLSSNRParams &params,
+                   Result &output)
+{
+  if (!color.is_allocated() || color.is_single_value()) {
+    return false;
+  }
+  const int2 size = color.domain().data_size;
+  const int width = size.x;
+  const int height = size.y;
+  if (width < 32 || height < 32) {
+    set_nr_error("DLSSNR requires an input of at least 32x32.");
+    return false;
+  }
+  if (!ensure_device()) {
+    return false;
+  }
+  if (snippet_ == nullptr && !load_modules()) {
+    return false;
+  }
+  if (params_ == nullptr && !alloc_params()) {
+    return false;
+  }
+  if (!ngx_ready_ && !init_ngx_session()) {
+    return false;
+  }
+
+  const bool have_depth = depth != nullptr && depth->is_allocated() && !depth->is_single_value();
+  const bool have_motion = motion != nullptr && motion->is_allocated() &&
+                           !motion->is_single_value();
+  const bool have_mask = mask != nullptr && mask->is_allocated() && !mask->is_single_value();
+
+  if (!ensure_feature(width, height, have_depth, have_motion, params)) {
+    return false;
+  }
+
+  const bool do_reset = params.reset || last_view_key_ != params.view_key;
+  last_view_key_ = params.view_key;
+  has_history_ = !do_reset;
+
+  set_params(width, height, have_depth, have_motion, params, do_reset);
+  stage_inputs(color,
+               have_depth ? depth : nullptr,
+               have_motion ? motion : nullptr,
+               width,
+               height,
+               params.clamp_input);
+  copy_texture_from_upload();
+
+  const NgxResult result = call_eval(snippet_eval_, cmdlist_.Get(), handle_, params_);
+  if (result != kNgxSuccess) {
+    char buffer[128];
+    SNPRINTF(buffer, "EvaluateFeature failed (0x%08x)", unsigned(result));
+    set_nr_error(buffer);
+    return false;
+  }
+  copy_texture_to_readback();
+  execute_and_wait();
+  download_color(output, color, have_mask ? mask : nullptr, width, height, params.clamp_input);
+  return true;
+}
+
+class CompositorDLSSNR {
+ public:
+  static CompositorDLSSNR &instance()
+  {
+    static CompositorDLSSNR singleton;
+    return singleton;
+  }
+
+  bool apply(const Result &color,
+             const Result *depth,
+             const Result *motion,
+             const Result *mask,
+             const DLSSNRParams &params,
+             Result &output)
+  {
+    std::lock_guard<std::mutex> guard{mutex_};
+    return dlssnr_.apply(color, depth, motion, mask, params, output);
+  }
+
+  CompositorDLSSNR(const CompositorDLSSNR &) = delete;
+  CompositorDLSSNR &operator=(const CompositorDLSSNR &) = delete;
+
+ private:
+  CompositorDLSSNR() = default;
+  ~CompositorDLSSNR() = default;
+
+  std::mutex mutex_;
+  Dx12NR dlssnr_;
+};

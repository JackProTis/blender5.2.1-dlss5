+  void copy_texture_from_upload();
+  void copy_texture_to_readback();
+  void download_color(Result &output, const Result &color, const Result *mask, int width, int height, bool clamp_input);
+
+  ComPtr<IDXGIAdapter1> adapter_;
+  ComPtr<ID3D12Device> device_;
+  ComPtr<ID3D12CommandQueue> queue_;
+  ComPtr<ID3D12CommandAllocator> allocator_;
+  ComPtr<ID3D12GraphicsCommandList> cmdlist_;
+  ComPtr<ID3D12Fence> fence_;
+  HANDLE event_ = nullptr;
+  UINT64 fence_value_ = 0;
+
+  HMODULE core_ = nullptr;
+  HMODULE snippet_ = nullptr;
+  std::wstring runtime_dir_;
+  std::wstring cache_dir_;
+  NVSDK_NGX_Parameter *params_ = nullptr;
+  NVSDK_NGX_Handle *handle_ = nullptr;
+  const wchar_t *feature_paths_[1] = {nullptr};
+  void **iat_slot_ = nullptr;
+  bool ngx_ready_ = false;
+
+  NgxInitProjectFn core_init_project_id_ = nullptr;
+  NgxInitProjectFn core_init_project_ = nullptr;
+  NgxInitExtCoreFn core_init_ext_ = nullptr;
+  NgxShutdownFn core_shutdown1_ = nullptr;
+  NgxAllocFn core_alloc_params_ = nullptr;
+  NgxDestroyPFn core_destroy_params_ = nullptr;
+  NgxInitExtSnippetFn snippet_init_ext_ = nullptr;
+  NgxInitExtCoreFn snippet_init_ext_core_abi_ = nullptr;
+  NgxCreateFn snippet_create_ = nullptr;
+  NgxEvalFn snippet_eval_ = nullptr;
+  NgxReleaseFn snippet_release_ = nullptr;
+
+  ComPtr<ID3D12Resource> tex_color_;
+  ComPtr<ID3D12Resource> tex_output_;
+  ComPtr<ID3D12Resource> tex_depth_;
+  ComPtr<ID3D12Resource> tex_motion_;
+  ComPtr<ID3D12Resource> upload_;
+  ComPtr<ID3D12Resource> readback_;
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp_color_ = {};
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp_depth_ = {};
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp_motion_ = {};
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp_output_ = {};
+  UINT64 color_bytes_ = 0;
+  UINT64 depth_bytes_ = 0;
+  UINT64 motion_bytes_ = 0;
+  UINT64 output_bytes_ = 0;
+  int last_width_ = 0;
+  int last_height_ = 0;
+  int last_style_ = -1;
+  bool last_have_depth_ = false;
+  bool last_have_motion_ = false;
+  uint64_t last_view_key_ = 0;
+  bool has_history_ = false;
+};bool Dx12NR::ensure_adapter()
+{
+  if (adapter_ != nullptr) {
+    return true;
+  }
+  ComPtr<IDXGIFactory1> factory;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
+    set_nr_error("CreateDXGIFactory1 failed.");
+    return false;
+  }
+  for (unsigned int index = 0;; ++index) {
+    ComPtr<IDXGIAdapter1> candidate;
+    if (factory->EnumAdapters1(index, &candidate) == DXGI_ERROR_NOT_FOUND) {
+      break;
+    }
+    DXGI_ADAPTER_DESC1 desc = {};
+    if (SUCCEEDED(candidate->GetDesc1(&desc)) && (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) == 0 &&
+        desc.VendorId == 0x10DE)
+    {
+      adapter_ = candidate;
+      return true;
+    }
+  }
+  set_nr_error("No NVIDIA D3D12 adapter found. DLSSNR runs on NVIDIA GPUs only.");
+  return false;
+}
+
+bool Dx12NR::ensure_device()
+{
+  if (device_ != nullptr) {
+    return true;
+  }
+  if (!ensure_adapter()) {
+    return false;
+  }
+  if (FAILED(D3D12CreateDevice(adapter_.Get(), D3D_FEATURE_LEVEL_12_0, IID_PPV_ARGS(&device_)))) {
+    set_nr_error("D3D12CreateDevice failed.");
+    return false;
+  }
+  D3D12_COMMAND_QUEUE_DESC queue_desc = {};
+  queue_desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+  if (FAILED(device_->CreateCommandQueue(&queue_desc, IID_PPV_ARGS(&queue_)))) {
+    set_nr_error("CreateCommandQueue failed.");
+    return false;
+  }
+  if (FAILED(device_->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator_)))) {
+    set_nr_error("CreateCommandAllocator failed.");
+    return false;
+  }
+  if (FAILED(device_->CreateCommandList(0,
+                                        D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                        allocator_.Get(),
+                                        nullptr,
+                                        IID_PPV_ARGS(&cmdlist_))))
+  {
+    set_nr_error("CreateCommandList failed.");
+    return false;
+  }
+  if (FAILED(device_->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence_)))) {
+    set_nr_error("CreateFence failed.");
+    return false;
+  }
+  event_ = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  if (event_ == nullptr) {
+    set_nr_error("CreateEventW failed.");
+    return false;
+  }
+  return true;
+}
+
+void Dx12NR::execute_and_wait()
+{
+  if (cmdlist_ == nullptr || queue_ == nullptr || fence_ == nullptr || event_ == nullptr) {
+    return;
+  }
+  if (FAILED(cmdlist_->Close())) {
+    return;
+  }
+  ID3D12CommandList *lists[] = {cmdlist_.Get()};
+  queue_->ExecuteCommandLists(1, lists);
+  ++fence_value_;
+  queue_->Signal(fence_, fence_value_);
+  if (fence_->GetCompletedValue() < fence_value_) {
+    fence_->SetEventOnCompletion(fence_value_, event_);
+    WaitForSingleObject(event_, 30000);
+  }
+  allocator_->Reset();
+  cmdlist_->Reset(allocator_.Get(), nullptr);
+}
+
+Dx12NR::~Dx12NR()
+{
+  if (handle_ != nullptr && snippet_release_ != nullptr) {
+    snippet_release_(handle_);
+  }
+  handle_ = nullptr;
+  if (params_ != nullptr && core_destroy_params_ != nullptr) {
+    core_destroy_params_(params_);
+  }
+  params_ = nullptr;
+  if (core_ != nullptr && core_shutdown1_ != nullptr && device_ != nullptr) {
+    core_shutdown1_(device_.Get());
+  }
+  if (iat_slot_ != nullptr && g_original_get_module != nullptr) {
+    write_iat(iat_slot_, reinterpret_cast<void *>(g_original_get_module));
+  }
+  iat_slot_ = nullptr;
+  g_hooked_snippet = nullptr;
+  g_hooked_core = nullptr;
+  if (core_ != nullptr) {
+    FreeLibrary(core_);
+  }
+  if (snippet_ != nullptr) {
+    FreeLibrary(snippet_);
+  }
+  core_ = nullptr;
+  snippet_ = nullptr;
+  if (event_ != nullptr) {
+    CloseHandle(event_);
+    event_ = nullptr;
+  }
+}

+static std::wstring find_nr_runtime_dir()
+{
+  const auto has_dll = [](const std::wstring &dir) -> bool {
+    return std::filesystem::is_regular_file(std::filesystem::path(dir) / L"nvngx_dlssnr.dll");
+  };
+
+  const wchar_t *env = _wgetenv(L"DLSS5_RUNTIME_DIR");
+  if (env != nullptr && *env != 0 && has_dll(env)) {
+    return env;
+  }
+
+  wchar_t module_path[MAX_PATH] = {};
+  const DWORD length = GetModuleFileNameW(nullptr, module_path, ARRAYSIZE(module_path));
+  if (length == 0 || length >= ARRAYSIZE(module_path)) {
+    return {};
+  }
+  const std::wstring executable = std::filesystem::path(module_path).parent_path().wstring();
+  const std::vector<std::wstring> candidates = {
+      (std::filesystem::path(executable) / L"dlss5").wstring(),
+      executable,
+  };
+  for (const std::wstring &candidate : candidates) {
+    if (has_dll(candidate)) {
+      return candidate;
+    }
+  }
+  return {};
+}
